# ---------------------------------------------------------------
# Rarum – Umgebungsvariablen
# Ohne Supabase-Werte läuft die App im lokalen Demo-Modus.
# ---------------------------------------------------------------

# Pflicht in Produktion: Geheimnis zum Signieren von Spielrunden und Ergebnis-Quittungen (mind. 32 Zeichen)
RUN_TOKEN_SECRET=

# Admin-Passwort für /admin (Demo-Modus). Im Entwicklungsmodus ohne Wert: "admin".
ADMIN_PASSWORD=

# Optional: Pfad des lokalen Datenspeichers im Demo-Modus (Standard: data/store.json)
# RARUM_DATA_FILE=

# --- Supabase (optional, aktiviert Konten, Sync, Freunde, Ranglisten) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nur serverseitig! Niemals im Browser verwenden oder committen.
SUPABASE_SERVICE_ROLE_KEY=
